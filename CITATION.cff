cff-version: 1.2.0
message: "If you use this software, please cite both the software and the original methodology paper."
type: software
title: "MetaIntegrator-py"
version: 1.0.0
date-released: 2026-11-04
url: "https://github.com/Khatri-Lab/metaintegrator_py"
repository-code: "https://github.com/Khatri-Lab/metaintegrator_py"
license: Apache-2.0
abstract: "A Python implementation for meta-analysis of gene expression data. MetaIntegrator-py provides fast, modern tools for integrating multiple genomic datasets, performing meta-analysis, and generating publication-quality visualizations. This package is based on the original R implementation while maintaining full methodological compatibility."

keywords:
  - meta-analysis
  - bioinformatics
  - gene expression
  - genomics
  - microarray
  - RNA-seq
  - GEO
  - transcriptomics

